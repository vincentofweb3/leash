# Copy to web/.env.local (never commit it).

# Which networks the app offers, comma-separated. The first is the default; with more than one,
# a switcher appears in the header.
#   aevum = QDay Aevum testnet (chain 44005)
#   fork  = `make fork`: local copy of Aevum on 127.0.0.1:8555 (chain 440050, real tUSD8)
#   local = `make anvil`: empty local chain on 127.0.0.1:8545 (chain 31337, MockUSD8)
NEXT_PUBLIC_NETWORKS=aevum

# Your Leash deployment on each network (printed by `make deploy-aevum`, `make deploy-fork`, `make deploy-local`).
NEXT_PUBLIC_LEASH_AEVUM=
NEXT_PUBLIC_LEASH_FORK=
NEXT_PUBLIC_LEASH_LOCAL=

# Optional. Only scan events from this block onward on the Activity page (speeds it up).
NEXT_PUBLIC_DEPLOY_BLOCK_AEVUM=
NEXT_PUBLIC_DEPLOY_BLOCK_FORK=

# Optional. Enables WalletConnect (mobile wallets via QR). Free at https://cloud.reown.com
# Without it the app still works with browser-extension wallets (MetaMask, Rabby, …).
NEXT_PUBLIC_WC_PROJECT_ID=

# Optional. Where the Docs page's "Source" link and clone command point (your fork, a preview repo…).
# Default: https://github.com/vincentofweb3/leash
NEXT_PUBLIC_REPO_URL=
