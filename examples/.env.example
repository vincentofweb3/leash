# Copy to examples/.env (never commit it).

# RPC to use. Aevum testnet by default; http://127.0.0.1:8555 for `make fork`, http://127.0.0.1:8545 for `make anvil`.
RPC_URL=https://rpc-test.qday.info

# Path to the policy bundle the buyer gave you (see `leash show`).
LEASH_BUNDLE=./bundle.json

# Session key of the agent (from `leash keygen`). Throwaway TEST wallets only.
LEASH_AGENT_KEY=

# pay: the vendor to pay and the amount in tUSD8.
VENDOR=
AMOUNT=1.5
PURPOSE=example spend

# check-setup: the address to inspect. read-spends: if set, FROM_BLOCK=2970000 scans from there.
ADDRESS=
FROM_BLOCK=
